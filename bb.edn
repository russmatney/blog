{:paths ["bb"]
 :deps  {tick/tick           {:mvn/version "1.0"}
         russmatney/org-crud {:git/url "https://github.com/russmatney/org-crud"
                              :git/sha "b7ac5818b57378427b7bbc8ad865acd398edabe7"}
         org.babashka/json   {:mvn/version "0.1.6"}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.edn :as edn]
             [clojure.string :as str]
             [blog.tasks :as tasks]
             )
  :init
  (do
    (defn log [& args]
      (apply println args))

    (defn shelll [& args]
      (apply println args)
      (apply shell args)))

  ;; === Astro/Starlight Commands ===

  dev
  (do
    (log "Starting Astro dev server...")
    (shelll "npm run dev"))

  build
  (do
    (log "Building Astro site...")
    (shelll "npm run build"))

  preview
  (do
    (log "Previewing built site...")
    (shelll "npm run preview"))

  serve
  (do
    (log "Alias for dev...")
    (shelll "npm run dev"))

  watch
  (do
    (log "Alias for dev (with nREPL suggestion)...")
    (when true #_osx?
          (println "you might want to 'bb --nrepl-server 1667'"))
    (shelll "npm run dev"))

  ;; === Migration Utilities ===

  migrate-frontmatter
  (do
    (log "Migrating frontmatter...")
    (require '[blog.migrate :as m])
    (m/migrate-all-posts))

  copy-to-astro
  (do
    (log "Copying content to Astro...")
    (require '[blog.copy-to-astro :as c])
    (c/copy-all-content)
    (c/copy-assets))

  fix-assets
  {:doc  "Fix asset paths for Astro migration"
   :task (load-file "bb/blog/fix_assets.clj")}

  fix-titles
  {:doc  "Remove duplicate H1 headings"
   :task (load-file "bb/blog/fix_duplicate_titles.clj")}

  new-hundo
  {:doc  "Create a new hundo. Usage: bb new-hundo <title>"
   :task (do
           (let [title   (str/join " " *command-line-args*)
                 _       (when (str/blank? title)
                           (println "Usage: bb new-hundo <title>")
                           (System/exit 1))
                 slug    (-> title
                             str/lower-case
                             (str/replace (re-pattern "[^a-z0-9]+") "-")
                             (str/replace (re-pattern "-+$") "")
                             (str/replace (re-pattern "^-+") ""))
                 today   (.format (java.time.LocalDate/now)
                                  (java.time.format.DateTimeFormatter/ofPattern "yyyy-MM-dd"))
                 fname   (str today "-" slug ".md")
                 dir     (str (fs/home) "/russmatney/blog/src/content/docs/posts/100-worders")
                 path    (str dir "/" fname)
                 content (str "---\ntitle: \"" title "\"\ndate: " today "\ncategory: hundos\ntags: [hundos, writing]\n---\n\n")]
             (if (fs/exists? path)
               (println "Already exists:" path)
               (do
                 (spit path content)
                 (println "Created:" path)))))}


  ;; === DEPRECATED: Old Docsify Commands ===

  build-old
  (do
    (log "⚠️  DEPRECATED: This was for Docsify page generation")
    (log "The blog now uses Astro/Starlight")
    (log "Use 'bb build' to build the Astro site")
    (tasks/regen-all-pages))

  serve-old
  (do
    (log "⚠️  DEPRECATED: This was for Docsify")
    (log "Use 'bb dev' for Astro dev server")
    (shelll "docsify serve docs"))
  }}
