---
// Custom head component for hash-based URL redirects (Docsify -> Astro migration)
---

<meta charset="utf-8" />
<link rel="alternate" type="application/rss+xml" title="Russell Matney RSS Feed" href="/rss.xml" />

<script is:inline>
  // Redirect old Docsify hash-based URLs to new Astro paths
  // Example: https://russmatney.com/#/devlogs/2025-06-10-dothop-speedrun
  //       -> https://russmatney.com/devlogs/2025-06-10-dothop-speedrun
  (function() {
    const hash = window.location.hash;
    if (hash && hash.startsWith('#/')) {
      const path = hash.substring(2); // Remove '#/'
      const newUrl = window.location.origin + '/' + path;
      window.location.replace(newUrl);
    }

    // Redirect .md URLs to their correct paths (legacy link support)
    const currentPath = window.location.pathname;
    if (currentPath.endsWith('.md')) {
      const newPath = currentPath.slice(0, -3);
      window.location.replace(newPath);
    }
  })();
</script>
